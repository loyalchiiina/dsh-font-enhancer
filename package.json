{
  "name": "dsh-font-enhancer",
  "version": "1.5.2",
  "description": "DSH 界面字体全权 DIY：10 个内置区域 + 框选建区，每区域独立设中英文字体/字号/行距/字重/斜体/颜色；全局统一、主题方案保存切换、随机配色、8 款可爱字体一键安装、128 款悬浮球皮肤三球共享。| DIY your DSH UI typography: 10 built-in regions plus box-select region creation, per-region Chinese/English font + size + line-height + weight + italic + colour, unified overrides, saved themes, random palettes, one-click cute-font install, and a 128-skin catalogue shared with two sibling balls.",
  "type": "module",
  "main": "lib/index.js",
  "sideEffects": false,
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "lib/**/*.js",
    "lib/fonts/*.ttf",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib/orb/*.html",
    "docs/images/**",
    "locale/*.json",
    "icon.svg",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "font",
    "字体",
    "typography",
    "排版",
    "DIY",
    "theme",
    "主题",
    "color",
    "颜色",
    "ui",
    "区域",
    "region",
    "styling",
    "样式",
    "chinese-font",
    "中文字体",
    "english-font",
    "英文字体",
    "font-picker",
    "font-size",
    "字号",
    "line-height",
    "行距",
    "字重",
    "font-weight",
    "斜体",
    "italic",
    "text-color",
    "文字颜色",
    "box-select",
    "框选",
    "pick-region",
    "unified",
    "统一",
    "theme-switch",
    "主题切换",
    "theme-preset",
    "配置方案",
    "random-color",
    "随机配色",
    "cute-font",
    "可爱字体",
    "font-installer",
    "字体安装",
    "ball-skin",
    "悬浮球皮肤",
    "custom-font",
    "自定义字体"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-font-enhancer.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-font-enhancer#readme",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-font-enhancer/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1"
  },
  "packageManager": "pnpm@11.7.0"
}
