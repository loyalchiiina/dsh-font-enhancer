{
    "name":  "dsh-font-enhancer",
    "version": "1.4.11",
    "description":  "DSH 界面字体全权 DIY：按区域自定义中英文字体、字号、行高、字重、斜体与颜色，支持框选页面元素创建自定义区域、全局统一控制、主题保存与切换、随机字体/配色，一键下载安装可爱字体（霞鹜文楷/得意黑/站酷快乐体等），支持自定义字体文件。桌面端 + 网页端双端可用。| DIY your DSH UI fonts and colours: per-region Chinese/English font, size, line-height, weight, italic and colour, pick elements on the live page to create custom regions, unified global overrides, theme save and switch, random font/colour generators, and one-click cute font install. Works in both Desktop and Web GUI.",
    "type":  "module",
    "main":  "lib/index.js",
    "sideEffects":  false,
    "engines":  {
                    "node":  "\u003e=18"
                },
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/**/*.js",
                  "lib/fonts/*.ttf",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE",
                  "lib/orb/*.html"
              ],
    "license":  "MIT",
    "keywords":  [
                     "dsh-plugin",
                     "deepseek-harness",
                     "font",
                     "字体",
                     "typography",
                     "排版",
                     "DIY",
                     "theme",
                     "主题",
                     "color",
                     "颜色",
                     "ui",
                     "区域",
                     "styling",
                     "样式",
                     "chinese-font",
                     "中文字体",
                     "english-font",
                     "font-picker",
                     "font-size",
                     "字重",
                     "斜体",
                     "theme-switch",
                     "主题切换",
                     "text-styling",
                     "文字样式",
                     "custom-font",
                     "自定义字体"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/loyalchiiina/dsh-font-enhancer.git"
                   },
    "homepage":  "https://github.com/loyalchiiina/dsh-font-enhancer#readme",
    "bugs":  {
                 "url":  "https://github.com/loyalchiiina/dsh-font-enhancer/issues"
             },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-connection",
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-slots",
                                              "@deepseek-ai/dsh-client-locale"
                                          ],
                               "platform":  "web"
                           }
            }
}